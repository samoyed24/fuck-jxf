# 复制为 .env 并填写；.env 已被 gitignore，不会提交
JXF_USERNAME=你的学号
JXF_PASSWORD=你的密码

# 坐标无需配置：脚本会自动复用最近一次成功签到的坐标。
# 若从未签到过，请先在小程序里手动签到一次。


# ---------------------------------------------------------------
# 通知开关（与通道无关，控制「何时通知」）
# ---------------------------------------------------------------
# 签到成功时是否通知，默认 true
JXF_NOTIFY_SUCCESS=true
# 签到失败时是否通知，默认 true
JXF_NOTIFY_FAILURE=true

# 说明：默认两个都开。成功通知同时充当心跳信号 —— 若某周未收到，
# 说明任务未执行（workflow 被停用、凭据失效等），可据此察觉静默故障。


# ---------------------------------------------------------------
# 通知通道 1：Portcloud Notify（推荐）
# ---------------------------------------------------------------
# 自己配置 SMTP 比较麻烦，建议直接用这个托管服务。
# 使用前需先给该服务的 GitHub 仓库点 Star（控制台内会给出链接），
# 否则返回 403 STAR_REQUIRED。
# 配置步骤见 README「配置 Secrets」一节。
#
# API Key，形如 pck_xxx
JXF_PC_KEY=
# 收件邮箱（需先在控制台 Recipients 中验证）
JXF_PC_TO=
# API 地址，默认 https://notify.portcloud.online，一般不用填
JXF_PC_URL=


# ---------------------------------------------------------------
# 通知通道 2：SMTP 邮件（可选，全部留空则不使用该通道）
# ---------------------------------------------------------------
# SMTP 服务器，如 smtp.qq.com / smtp.163.com
JXF_MAIL_HOST=
# 端口，默认 465（SSL）
JXF_MAIL_PORT=
# 发件邮箱
JXF_MAIL_USER=
# 邮箱授权码（不是登录密码）
JXF_MAIL_PASSWORD=
# 收件邮箱
JXF_MAIL_TO=
