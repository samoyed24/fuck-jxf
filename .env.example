# 复制为 .env 并填写；.env 已被 gitignore，不会提交
JXF_USERNAME=你的学号
JXF_PASSWORD=你的密码

# 坐标无需配置：脚本会自动复用最近一次成功签到的坐标。
# 若从未签到过，请先在小程序里手动签到一次。


# ---------------------------------------------------------------
# 邮件通知（可选，全部留空则不发邮件）
# ---------------------------------------------------------------
# SMTP 服务器，如 smtp.qq.com / smtp.163.com
JXF_MAIL_HOST=
# 端口，默认 465（SSL）
JXF_MAIL_PORT=
# 发件邮箱
JXF_MAIL_USER=
# 邮箱授权码（不是登录密码）
JXF_MAIL_PASSWORD=
# 收件邮箱
JXF_MAIL_TO=

# 签到成功时是否发邮件，默认 false
JXF_MAIL_NOTIFY_SUCCESS=false
# 签到失败时是否发邮件，默认 true
JXF_MAIL_NOTIFY_FAILURE=true
